{
  "name": "endchimerge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EndchiMerge（方團團大作戰）— a browser-based physics merge puzzle game. Unofficial fan project.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sign": "node scripts/sign-assets.mjs public/assets/character",
    "sign:check": "node scripts/sign-assets.mjs --check public/assets/character",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "matter-js": "^0.20.0"
  }
}

# 統一換行符號，避免跨平台（Windows / macOS / Linux）產生無意義的 diff 雜訊。
# Normalise line endings so cross-platform checkouts (Windows / macOS / Linux)
# do not produce meaningless diff churn.
* text=auto eol=lf

*.svg text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary

# Git hooks 必須保持 LF，否則在 Linux / macOS 上會無法執行。
# Git hooks must stay LF or they will not run on Linux / macOS.
/.githooks/** text eol=lf
